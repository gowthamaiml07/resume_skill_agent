# .streamlit/secrets.toml.example
# ==============================================================================
# Streamlit Secrets Configuration Template
# ==============================================================================
# To use:
# 1. Copy this file to .streamlit/secrets.toml
# 2. Replace the placeholder below with your newly generated Groq API key from https://console.groq.com/keys
#
# IMPORTANT: Never commit .streamlit/secrets.toml or real keys to Git!

GROQ_API_KEY = "gsk_replace_with_your_new_groq_key"
GROQ_MODEL = "llama-3.3-70b-versatile"

# Optional: OpenAI Configuration
# OPENAI_API_KEY = "sk-proj-..."
# OPENAI_MODEL = "gpt-4o-mini"
